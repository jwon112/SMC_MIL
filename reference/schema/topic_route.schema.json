{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic_route.schema.json",
  "title": "Project literature topic route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_id",
    "description",
    "query_terms",
    "preferred_evidence_types",
    "paper_ids",
    "claim_ids",
    "fallback_topics"
  ],
  "properties": {
    "linked_local_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "topic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {"type": "string", "minLength": 1},
    "query_terms": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "preferred_evidence_types": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "paper_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "claim_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "fallback_topics": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
