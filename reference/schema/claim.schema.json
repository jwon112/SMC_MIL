{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Project literature claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "statement",
    "evidence_ids",
    "review_status",
    "tags"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "statement": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "review_status": {
      "enum": ["draft", "reviewed", "needs_update"]
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "last_reviewed": {
      "type": ["string", "null"],
      "format": "date"
    }
  }
}
